  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Registrar colores custom como utilidades Tailwind (text-edit, text-delete, text-view) */
@theme {
  --color-edit:   #ca8a04;
  --color-delete: #ea580c;
  --color-view:   #3b82f6;
}

/* ── Tabla Cupertino-pro ──────────────────────────────────────────────────
   Look profesional inspirado en macOS/Cupertino: headers UPPERCASE pequeños
   con tracking, filas limpias, hover sutil. Funciona idéntico en light/dark
   gracias a color-mix sobre base-content.
   ─────────────────────────────────────────────────────────────────────── */
@layer components {
  .table {
    border-collapse: separate;
    border-spacing: 0;
  }
  .table thead {
    background-color: color-mix(in oklab, var(--color-base-content) 10%, var(--color-base-200));
  }
  .table thead th {
    padding: 0.875rem 1rem;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-base-content);
    border-bottom: 1px solid color-mix(in oklab, var(--color-base-content) 15%, transparent);
    text-align: left;
    white-space: nowrap;
  }
  .table tbody td {
    font-size: 0.875rem;
    color: var(--color-base-content);
    border-bottom: 1px solid color-mix(in oklab, var(--color-base-content) 5%, transparent);
    vertical-align: middle;
  }
  .table tbody tr {
    transition: background-color 0.15s ease;
  }
  .table tbody tr:last-child td {
    border-bottom: none;
  }
  .table tbody tr:hover {
    background-color: color-mix(in oklab, var(--color-base-content) 8%, transparent);
  }
  /* Zebra — muy sutil, casi imperceptible (estilo macOS Finder) */
  .table-zebra tbody tr:nth-child(even) {
    background-color: color-mix(in oklab, var(--color-base-content) 2%, transparent);
  }
  .table-zebra tbody tr:nth-child(even):hover {
    background-color: color-mix(in oklab, var(--color-base-content) 9%, transparent);
  }
  /* Footer — totales/sumarizaciones */
  .table tfoot tr {
    background-color: color-mix(in oklab, var(--color-base-content) 4%, var(--color-base-100));
    border-top: 1px solid color-mix(in oklab, var(--color-base-content) 12%, transparent);
  }
  .table tfoot td {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-base-content);
  }
  /* Variante compacta */
  .table-sm thead th { padding: 0.5rem 0.75rem; font-size: 0.65rem; }
  .table-sm tbody td { padding: 0.625rem 0.75rem; font-size: 0.8125rem; }

  /* ── Mobile: card compacto y profesional ─────────────────────────────
     Layout fijo en 3 líneas:
       Línea 1: PTI ID (izq.)         · Operador ID (der.)
       Línea 2: Nombre del sitio      · Tipo (badge der.)
       Línea 3: Región · Comuna       · Acciones (der.)
     ───────────────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .table-card { background-color: transparent; }
    .table { display: block; background: transparent; }
    .table thead { display: none; }
    .table tbody { display: block; background-color: var(--color-secondary); padding-top: 0.25rem; }
    .table tbody tr {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      align-content: flex-start;
      gap: 0 0.5rem;
      margin-bottom: 0.25rem;
      padding-top: 0.25rem;
      padding-bottom: 0;
      padding-left: 0.5rem;
      padding-right: 0.5rem;
      background-color: var(--color-base-100);
      border: 1px solid color-mix(in oklab, var(--color-base-content) 7%, transparent);
      border-radius: var(--radius-box);
    }
    .table tbody tr:hover,
    .table-zebra tbody tr:nth-child(even),
    .table-zebra tbody tr:nth-child(even):hover {
      background-color: var(--color-base-100);
    }
    /* Reset de cell base */
    .table tbody td {
      display: inline-flex;
      align-items: center;
      padding: 0;
      border: none;
      font-size: 0.72rem;
      line-height: 1.15;
      color: color-mix(in oklab, var(--color-base-content) 65%, transparent);
      white-space: normal;
    }
    .table tbody td::before { display: none; }
    .table tbody td:empty { display: none; }
    /* Saltos de línea forzados con pseudo-elementos + order */
    .table tbody tr::before,
    .table tbody tr::after {
      content: '';
      width: 100%;
      flex-basis: 100%;
      height: 0;
    }
    .table tbody tr::before { order: 3; }   /* break entre cell 2 y 3 */
    .table tbody tr::after  { order: 6; }   /* break entre cell 4 y 5 */

    /* Posicionamiento por orden */
    .table tbody td:nth-child(1) {                      /* PTI ID — izq línea 1 */
      order: 1;
      font-size: 0.78rem; font-weight: 600;
      color: var(--color-base-content);
    }
    .table tbody td:nth-child(2) {                      /* Operador — der línea 1 */
      order: 2; margin-left: auto;
      font-size: 0.78rem; font-weight: 600;
      color: var(--color-base-content);
    }
    .table tbody td:nth-child(3) {                      /* Nombre — izq línea 2 */
      order: 4;
      font-size: 0.9rem; font-weight: 700;
      color: var(--color-base-content);
    }
    .table tbody td:nth-child(4) {                      /* Tipo badge — der línea 2 */
      order: 5; margin-left: auto;
    }
    .table tbody td:nth-child(4) .badge {
      --size: 1rem;
      font-size: 0.6rem;
    }
    .table tbody td:nth-child(5) { order: 7; }          /* Región */
    .table tbody td:nth-child(6) {                      /* Comuna — separada con · */
      order: 8;
    }
    .table tbody td:nth-child(6)::before {
      content: "·";
      margin-right: 0.375rem;
      color: color-mix(in oklab, var(--color-base-content) 30%, transparent);
    }
    .table tbody td[data-label="Acciones"] {            /* Acciones — der línea 3 */
      order: 9; margin-left: auto;
    }
    .table tbody td[data-label="Acciones"] .btn {
      min-height: 1.5rem; height: 1.5rem; width: 1.5rem; padding: 0;
    }

    /* Ocultar el botón "Cargar Excel" en mobile */
    #importSiteBtn { display: none !important; }

    /* ─ Layout mobile tabla contratistas ─ */
    .contractors-table tbody td:nth-child(1) {   /* Nombre — izq línea 1 */
      order: 1;
      font-size: 0.9rem; font-weight: 700;
      color: var(--color-base-content);
    }
    .contractors-table tbody td:nth-child(2) {   /* Código — der línea 1 */
      order: 2; margin-left: auto;
      font-size: 0.78rem; font-weight: 600;
      color: var(--color-base-content);
    }
    .contractors-table tbody td:nth-child(3) {   /* Estado badge — izq línea 2 */
      order: 4;
    }
    .contractors-table tbody td[data-label="Acciones"] {   /* der línea 2 */
      order: 5; margin-left: auto;
    }
  }

  /* ── Card contenedor de tabla ──────────────────────────────────────── */
  .table-card {
    background-color: var(--color-base-200);
    border-radius: 0.5rem;
    overflow: clip;
  }
  .table-card-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-base-content) 8%, transparent);
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--color-base-200);
  }
  @media (min-width: 768px) {
    .table-card-header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .table-card-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-base-content);
    margin: 0;
  }
  .table-card-subtitle {
    font-size: 0.8125rem;
    color: color-mix(in oklab, var(--color-base-content) 60%, transparent);
    margin-top: 0.125rem;
  }
  /* Search pill estilo Cupertino */
  .table-search {
    position: relative;
  }
  .table-search input {
    padding-left: 2.25rem;
    border-radius: 9999px;
    background-color: color-mix(in oklab, var(--color-base-content) 5%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-base-content) 10%, transparent);
    font-size: 0.875rem;
    height: 2.25rem;
    transition: all 0.15s ease;
  }
  .table-search input:focus {
    outline: none;
    background-color: var(--color-base-100);
    border-color: color-mix(in oklab, var(--color-base-content) 25%, transparent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-base-content) 6%, transparent);
  }
  .table-search-icon {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.75rem;
    color: color-mix(in oklab, var(--color-base-content) 40%, transparent);
    pointer-events: none;
  }
  /* Footer del card (paginación, conteo) */
  .table-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid color-mix(in oklab, var(--color-base-content) 8%, transparent);
    background-color: var(--color-base-200);
    font-size: 0.8125rem;
    color: color-mix(in oklab, var(--color-base-content) 60%, transparent);
  }

  /* ── Mobile overrides POSTERIORES a las reglas base (ganan en el cascade) ─ */
  @media (max-width: 768px) {
    .table-card {
      overflow: visible;        /* Evita que overflow:clip corte el footer en mobile */
      background-color: transparent;  /* El bloque de arriba no gana por orden de cascade */
    }
  }
}

/* Selects — opciones desplegadas con bg/color del theme (sin esto el browser usa SO defaults) */
select option {
  background-color: var(--color-base-100);
  color: var(--color-base-content);
  padding: 0.5rem;
}
select option:checked,
select option:hover {
  background-color: color-mix(in oklab, var(--color-primary) 12%, var(--color-base-100));
  color: var(--color-base-content);
}

/* ── component_only / sub_elementos placeholders ────────────────────── */
.component-only-container {
  max-width: 100%;
  margin: 0 auto;
}
.sub-elemento-container {
  background: var(--color-base-100);
  border-radius: 0.5rem;
  padding: 1.5rem;
  border: 1px solid color-mix(in oklab, var(--color-base-content) 10%, transparent);
}
.mapa-placeholder,
.fotos-placeholder,
.table-placeholder,
.component-placeholder {
  min-height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── Editable table component ───────────────────────────────────────── */
.editable-cell {
  cursor: pointer;
  position: relative;
}
.editable-cell:hover {
  background-color: color-mix(in oklab, var(--color-base-content) 5%, transparent);
}
.editable-input,
.editable-select {
  width: 100%;
  border: 1px solid var(--color-info);
  padding: 2px 4px;
  border-radius: 3px;
  background: var(--color-base-100);
  color: var(--color-base-content);
}
.table-actions {
  display: flex;
  gap: 5px;
  justify-content: center;
}
.btn-action {
  padding: 2px 6px;
  font-size: 12px;
  border-radius: 3px;
  cursor: pointer;
  border: none;
}
.editable-loading {
  opacity: 0.5;
  pointer-events: none;
}
.editable-error-message {
  color: var(--color-error);
  font-size: 12px;
  margin-top: 2px;
}
.editable-success-message {
  color: var(--color-success);
  font-size: 12px;
  margin-top: 2px;
}

/* ── Login page (estilo Cupertino glass) ────────────────────────────── */
.login-page {
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
  min-height: 100vh;
  background: linear-gradient(160deg, var(--color-base-100) 0%, var(--color-base-200) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.login-card {
  background: color-mix(in oklab, var(--color-base-content) 7%, transparent);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid color-mix(in oklab, var(--color-base-content) 10%, transparent);
  border-radius: 24px;
  padding: 48px 36px;
  width: 100%;
  max-width: 360px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28px;
}
.login-logo {
  width: 72px;
  height: 72px;
  background: var(--color-primary);
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 24px rgba(0,0,0,0.3);
}
.login-logo img {
  width: 40px;
  height: 40px;
  object-fit: contain;
  filter: brightness(0) invert(1);
}
.login-subtitle {
  font-size: 0.875rem;
  color: color-mix(in oklab, var(--color-base-content) 50%, transparent);
  text-align: center;
  margin-top: -12px;
}
.login-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 20px;
  background: var(--color-primary);
  color: var(--color-primary-content);
  border: none;
  border-radius: 14px;
  font-size: 0.9375rem;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  transition: opacity 0.15s;
  box-shadow: 0 2px 12px rgba(0,0,0,0.25);
}
.login-btn:hover { opacity: 0.88; }
.login-btn:disabled { opacity: 0.5; cursor: not-allowed; }
.login-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.login-input {
  width: 100%;
  padding: 13px 16px;
  background: var(--color-base-200);
  border: 1px solid color-mix(in oklab, var(--color-base-content) 10%, transparent);
  border-radius: 12px;
  color: var(--color-base-content);
  font-size: 0.9375rem;
  outline: none;
  box-sizing: border-box;
  transition: border-color 0.15s;
}
.login-input:focus { border-color: var(--color-primary); }
.login-input::placeholder { color: color-mix(in oklab, var(--color-base-content) 35%, transparent); }
.login-error {
  width: 100%;
  padding: 10px 14px;
  background: color-mix(in srgb, var(--color-error) 15%, transparent);
  border: 1px solid color-mix(in srgb, var(--color-error) 40%, transparent);
  border-radius: 10px;
  color: var(--color-error);
  font-size: 0.8125rem;
  text-align: center;
  display: none;
}
.login-footer {
  font-size: 0.75rem;
  color: color-mix(in oklab, var(--color-base-content) 35%, transparent);
  text-align: center;
  text-decoration: none;
}
.login-footer:hover { color: color-mix(in oklab, var(--color-base-content) 60%, transparent); }
.login-info {
  width: 100%;
  padding: 10px 14px;
  background: color-mix(in srgb, var(--color-info) 15%, transparent);
  border: 1px solid color-mix(in srgb, var(--color-info) 40%, transparent);
  border-radius: 10px;
  color: var(--color-info);
  font-size: 0.8125rem;
  text-align: center;
}

/* Modales — borde de contraste para que no se confundan con el fondo */
.modal-box {
  border: 1px solid color-mix(in oklab, var(--color-base-content) 18%, transparent) !important;
  box-shadow:
    0 10px 30px color-mix(in oklab, var(--color-base-content) 25%, transparent),
    0 4px 12px color-mix(in oklab, var(--color-base-content) 15%, transparent) !important;
}
.modal-backdrop {
  background-color: color-mix(in oklab, var(--color-base-content) 40%, transparent) !important;
  backdrop-filter: blur(2px);
}

/* Toast notifications — fondo tintado por tipo + borde izquierdo del color */
.toast .alert {
  background-color: var(--color-base-100) !important;
  border-style: solid !important;
  border-width: 1px !important;
  border-color: color-mix(in oklab, var(--color-base-content) 10%, transparent) !important;
  border-left-width: 4px !important;
  border-radius: 0.5rem !important;
  box-shadow:
    0 4px 12px color-mix(in oklab, var(--color-base-content) 8%, transparent),
    0 12px 32px color-mix(in oklab, var(--color-base-content) 12%, transparent) !important;
  min-width: 300px;
  padding: 0.875rem 1rem !important;
  display: flex !important;
  align-items: center;
  gap: 0.75rem;
}
.toast .alert.alert-success {
  background-color: color-mix(in srgb, var(--color-success) 22%, var(--color-base-100)) !important;
  border-color: color-mix(in srgb, var(--color-success) 35%, transparent) !important;
  border-left-color: var(--color-success) !important;
  color: var(--color-success) !important;
}
.toast .alert.alert-error {
  background-color: color-mix(in srgb, var(--color-error) 22%, var(--color-base-100)) !important;
  border-color: color-mix(in srgb, var(--color-error) 35%, transparent) !important;
  border-left-color: var(--color-error) !important;
  color: var(--color-error) !important;
}
.toast .alert.alert-info {
  background-color: color-mix(in srgb, var(--color-info) 22%, var(--color-base-100)) !important;
  border-color: color-mix(in srgb, var(--color-info) 35%, transparent) !important;
  border-left-color: var(--color-info) !important;
  color: var(--color-info) !important;
}
.toast .alert.alert-warning {
  background-color: color-mix(in srgb, var(--color-warning) 22%, var(--color-base-100)) !important;
  border-color: color-mix(in srgb, var(--color-warning) 35%, transparent) !important;
  border-left-color: var(--color-warning) !important;
  color: var(--color-warning) !important;
}
/* Icono y texto heredan color del tipo, botón cerrar más sutil */
.toast .alert > i { color: inherit; }
.toast .alert > span { color: var(--color-base-content) !important; }
.toast .alert .alert-close-btn { color: color-mix(in oklab, var(--color-base-content) 50%, transparent) !important; }
.toast .alert .alert-close-btn:hover { color: var(--color-base-content) !important; }

/* HTMX indicator: oculto por defecto, visible solo durante request */
.htmx-indicator { display: none !important; }
.htmx-request .htmx-indicator,
.htmx-request.htmx-indicator { display: inline-block !important; }

