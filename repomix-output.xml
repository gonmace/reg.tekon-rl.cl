    var helpEl   = document.getElementById('help-text-' + dmsState.coordType + '-' + WID);
    if (helpEl) helpEl.textContent = grados + '° ' + minutos + "' " + segundos + '" ' + dirVal;
    dlg.close();
  }

})();
</script>

