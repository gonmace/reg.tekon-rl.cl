                      <i class="{{ ic }} text-xs"></i>{{ pw.widget_slug }}
                    </span>
                    {% endwith %}
                  {% empty %}
                    <span class="text-xs text-base-content/30 italic">—</span>
                  {% endfor %}
                </div>
              </td>
              <td class="text-center py-1 md:px-4">
                <div class="flex gap-1 justify-center">
                  <button type="button"
                          class="btn btn-xs btn-ghost tp-widget-btn"
                          data-paso-id="{{ cp.pasodef.pk }}"
                          data-paso-titulo="{{ cp.pasodef.titulo }}"
                          data-current-widgets="{% for pw in widgets %}{{ pw.widget_slug }}{% if not forloop.last %},{% endif %}{% endfor %}"
                          title="Asignar widgets">
                    {% if widgets %}
                      {% with ic=widget_icon_map|dict_get:widgets.0.widget_slug %}
                      <i class="{{ ic }}"></i>
                      {% endwith %}
                    {% else %}
                      <i class="fa-solid fa-puzzle-piece opacity-40"></i>
                    {% endif %}
                  </button>
                  <button type="button"
                          class="btn btn-xs btn-ghost tp-edit-btn"
                          data-id="{{ cp.pasodef.pk }}"
                          data-titulo="{{ cp.pasodef.titulo }}"
                          data-cp-id="{{ cp.pk }}"
