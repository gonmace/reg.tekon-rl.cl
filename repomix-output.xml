<file path="registros/templates/components/flexible_step.html">
{% extends 'base.html' %}
{% load crispy_forms_tags %}

{% block title %}{{ elemento_config.title|default:elemento.tipo|title }} - {% if registro.sitio %}{{ registro.sitio.name }}{% else %}{{ registro.title }}{% endif %}{% endblock %}

{% block pre_content %}{% endblock pre_content %}

{% block content %}
<div class="container mx-auto p-2 md:p-4 bg-base-100 rounded-lg shadow-lg">
    
    <!-- Título del paso -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800 mb-2">{{ elemento_config.title }}</h1>
        {% if elemento_config.description %}
            <p class="text-gray-600">{{ elemento_config.description }}</p>
        {% endif %}
    </div>

    <!-- Elementos del paso -->
    <div class="space-y-8">
        
        <!-- Elemento de Formulario -->
        {% if form %}
        <div class="card bg-base-200 shadow-lg">
            <div class="card-body">
                <h3 class="card-title">
                    {% if form.title %}{{ form.title }}{% else %}Formulario{% endif %}
                    {% if form.is_required %}
                        <span class="badge badge-error">Requerido</span>
                    {% endif %}
                </h3>
                {% if form.description %}
                    <p class="text-sm text-gray-600 mb-4">{{ form.description }}</p>
                {% endif %}
                
                <div class="{{ form.css_classes|default:'form-container' }}">
                    {% include 'components/elements/form_element.html' with form=form %}
                </div>
            </div>
        </div>
        {% endif %}
        
        <!-- Elemento de Tabla -->
        {% if table %}
        <div class="card bg-base-200 shadow-lg">
            <div class="card-body">
                <h3 class="card-title">
                    {{ table.title }}
                    {% if table.is_required %}
                        <span class="badge badge-error">Requerido</span>
                    {% endif %}
                </h3>
                {% if table.description %}
                    <p class="text-sm text-gray-600 mb-4">{{ table.description }}</p>
                {% endif %}
                
                <div class="{{ table.css_classes|default:'table-container' }}">
                    {% include 'components/elements/table_element.html' with table=table %}
                </div>
            </div>
        </div>
        {% endif %}
        
        <!-- Elemento de Mapa -->
        {% if map %}
        <div class="card bg-base-200 shadow-lg">
            <div class="card-body">
                <h3 class="card-title">
                    {{ map.title }}
                    {% if map.is_required %}
                        <span class="badge badge-error">Requerido</span>
                    {% endif %}
                </h3>
                {% if map.description %}
                    <p class="text-sm text-gray-600 mb-4">{{ map.description }}</p>
                {% endif %}
                
                <div class="{{ map.css_classes|default:'mapa-container' }}">
                    {% include 'components/elements/map_element.html' with map=map %}
                </div>
            </div>
        </div>
        {% endif %}
        
        <!-- Elemento de Fotos -->
        {% if photos %}
        <div class="card bg-base-200 shadow-lg">
            <div class="card-body">
                <h3 class="card-title">
                    {{ photos.title }}
                    {% if photos.is_required %}
                        <span class="badge badge-error">Requerido</span>
                    {% endif %}
                </h3>
                {% if photos.description %}
                    <p class="text-sm text-gray-600 mb-4">{{ photos.description }}</p>
                {% endif %}
                
                <div class="{{ photos.css_classes|default:'fotos-container' }}">
                    {% include 'components/elements/photos_element.html' with photos=photos %}
                </div>
            </div>
        </div>
        {% endif %}
        
        <!-- Elemento de Información -->
        {% if info %}
        <div class="card bg-base-200 shadow-lg">
            <div class="card-body">
                {% include 'components/elements/info_element.html' with info=info %}
            </div>
        </div>
        {% endif %}
        
        <!-- Elemento Personalizado -->
        {% if custom %}
        <div class="card bg-base-200 shadow-lg">
            <div class="card-body">
                {% include 'components/elements/custom_element.html' with custom=custom %}
            </div>
        </div>
        {% endif %}
        
    </div>
    
    <!-- Botones de navegación -->
    <div class="flex justify-between mt-8">
        <button type="button" class="btn btn-outline" onclick="history.back()">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Anterior
        </button>
        
        <button type="button" class="btn btn-primary" onclick="saveStep()">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Guardar y Continuar
        </button>
    </div>
    
</div>

<script>
function saveStep() {
    // Obtener el formulario si existe
    const form = document.querySelector('form');
    if (form) {
        form.submit();
    } else {
        // Si no hay formulario, solo navegar al siguiente paso
        window.location.href = '{{ paso_config.next_url|default:"#" }}';
    }
}

// Validación de completitud
document.addEventListener('DOMContentLoaded', function() {
    // Aquí puedes agregar validación JavaScript si es necesario
    console.log('Paso flexible cargado');
});
</script>
{% endblock %}
</file>

<file path="registros/templates/components/mapa.html">
{% load static %}

<div class="mapa-container">
    <!-- Botón para abrir el mapa -->
    <button type="button" 
            id="map-btn-{{ config.id|default:'default' }}"
            class="btn btn-{{ config.icon_config.color|default:'primary' }} btn-circle sombra"
            data-map-type="{{ config.type|default:'single_point' }}"
            data-coord1-lat="{{ config.lat_field|default:'lat' }}"
            data-coord1-lon="{{ config.lon_field|default:'lon' }}"
            data-coord1-label="{{ config.name_field|default:'name' }}"
            data-coord1-color="{{ config.icon_config.color|default:'#F59E0B' }}"
            data-coord1-size="{{ config.icon_config.size|default:'mid' }}"
            title="Ver mapa de {{ config.title|default:'ubicación' }}"
            onclick="openMapModal(this)">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
    </button>
    
    <!-- Información del mapa -->
    {% if config.description %}
        <div class="text-xs text-gray-600 mt-1">
            {{ config.description }}
        </div>
    {% endif %}
</div>

<script>
// Verificar si las coordenadas están disponibles para habilitar/deshabilitar el botón
document.addEventListener('DOMContentLoaded', function() {
    const btn = document.getElementById('map-btn-{{ config.id|default:"default" }}');
    if (btn) {
        // Verificar si hay coordenadas válidas
        const lat = btn.dataset.coord1Lat;
        const lon = btn.dataset.coord1Lon;
        
        if (!lat || !lon || lat === 'null' || lon === 'null') {
            btn.classList.add('btn-disabled');
            btn.title = 'No hay coordenadas disponibles';
        }
    }
});
</script>
</file>

<file path="registros/templates/components/sub_elemento_table.html">
{% load crispy_forms_tags %}

<div class="sub-elemento sub-elemento-table">
    <div class="card bg-base-100 shadow-xl">

            
            {% if data and data|length > 0 %}
                <form id="ejecucion-form" method="POST" action="{% url 'reg_construccion:guardar_ejecucion' registro.id %}">
                    {% csrf_token %}
                    <div class="overflow-x-auto">
                        <table class="table table-zebra w-full">
                            <thead>
                                <tr>
                                    <th class="text-left">COMPONENTES</th>
                                    <th class="text-center">% INCIDENCIA</th>
                                    <th class="text-center">% EJEC ANTERIOR</th>
                                    <th class="text-center">% EJEC ACTUAL</th>
                                    <th class="text-center">% EJEC ACUMULADA</th>
                                    <th class="text-center">% EJECUCION TOTAL</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in data %}
                                <tr>
                                    <td class="font-medium">{{ item.componente }}</td>
                                    <td class="text-center">{{ item.incidencia }}</td>
                                    <td class="text-center">{{ item.ejec_anterior }}</td>
                                    <td class="text-center font-semibold">
                                        <input type="number"
                                               name="ejec_actual_{{ item.componente_id }}"
                                               value="{{ item.ejec_actual_valor|default:0 }}"
                                               min="0"
                                               max="100"
                                               class="input input-sm input-bordered w-20 text-center"
                                               data-original-value="{{ item.ejec_actual_valor|default:0 }}"
                                               data-ejec-anterior="{{ item.ejec_anterior_valor|default:0 }}"
                                               data-incidencia="{{ item.incidencia_valor|default:0 }}"
                                               onchange="updateAcumulada(this)">
                                        <span class="text-xs ml-1">%</span>
                                    </td>
                                    <td class="text-center">
                                        <span id="ejec_acumulada_{{ item.componente_id }}">
                                            {{ item.ejec_acumulada }}
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span id="ejecucion_total_{{ item.componente_id }}">
                                            {{ item.ejecucion_total }}
                                        </span>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                            <tfoot>
                                <tr class="font-bold">
                                    <td>TOTAL</td>
                                    <td class="text-center">100.0%</td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td class="text-center">
                                        <span id="total_ejecucion_total">0.0%</span>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    
                    <!-- Botón para guardar cambios -->
                    <div class="flex justify-center mt-6 mb-4">
                        <button type="submit" 
                                class="btn btn-primary btn-lg"
                                id="guardar-btn"
                                disabled>
                            <i class="fas fa-save mr-2"></i>
                            Guardar Cambios
                        </button>
                    </div>
                </form>
                
                <!-- Información adicional con DaisyUI -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
                    <div class="card bg-primary text-primary-content">
                        <div class="card-body">
                            <h3 class="card-title text-sm">
                                <i class="fas fa-info-circle"></i>
                                Información del Proyecto
                            </h3>
                            <p class="text-xs">
                                <strong>Sitio:</strong> {{ registro.sitio.nombre|default:"No especificado" }}
                            </p>
                            <p class="text-xs">
                                <strong>Fecha:</strong> {{ registro.fecha|date:"d/m/Y" }}
                            </p>
                        </div>
                    </div>
                    
                    <div class="card bg-success text-success-content">
                        <div class="card-body">
                            <h3 class="card-title text-sm">
                                <i class="fas fa-chart-line"></i>
                                Progreso General
                            </h3>
                            <p class="text-xs">
                                <strong>Ejecución Total:</strong> <span id="info_ejecucion_total">{{ total_ejecucion_total|default:"0.0%" }}</span>
                            </p>
                            <p class="text-xs">
                                <strong>Componentes:</strong> {{ data|length }}
                            </p>
                        </div>
                    </div>
                    
                    <div class="card bg-warning text-warning-content">
                        <div class="card-body">
                            <h3 class="card-title text-sm">
                                <i class="fas fa-question-circle"></i>
                                Leyenda
                            </h3>
                            <p class="text-xs">
                                <strong>% Incidencia:</strong> Peso del componente
                            </p>
                            <p class="text-xs">
                                <strong>% Ejecución:</strong> Progreso real
                            </p>
                            <p class="text-xs">
                                <strong>% Total:</strong> Incidencia × Ejecución
                            </p>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="text-center py-8">
                    <div class="text-6xl mb-4 opacity-30">
                        <i class="fas fa-table"></i>
                    </div>
                    <h3 class="text-lg font-semibold mb-2">No hay componentes disponibles</h3>
                    <p class="text-sm opacity-70">Selecciona una estructura de proyecto para ver los componentes</p>
                </div>
            {% endif %}
   
    </div>
</div>

<script>
// Función para actualizar valores calculados
function updateAcumulada(input) {
    const ejecActual = parseInt(input.value) || 0;
    const ejecAnteriorVal = parseInt(input.getAttribute('data-ejec-anterior')) || 0;
    const incidenciaVal = parseFloat(input.getAttribute('data-incidencia')) || 0;
    
    // Calcular ejecución acumulada
    const ejecAcumulada = ejecAnteriorVal + ejecActual;
    
    // Calcular ejecución total
    const ejecucionTotal = (incidenciaVal / 100) * ejecAcumulada;
    
    // Actualizar valores en la tabla
    const componenteId = input.name.split('_')[2];
    document.getElementById(`ejec_acumulada_${componenteId}`).textContent = `${ejecAcumulada}%`;
    document.getElementById(`ejecucion_total_${componenteId}`).textContent = `${ejecucionTotal.toFixed(1)}%`;
    
    // Habilitar botón de guardar si hay cambios
    checkForChanges();
    
    // Actualizar totales
    updateTotales();
}

// Función para verificar si hay cambios
function checkForChanges() {
    const inputs = document.querySelectorAll('input[name^="ejec_actual_"]');
    let hasChanges = false;
    
    inputs.forEach(input => {
        const originalValue = parseInt(input.getAttribute('data-original-value')) || 0;
        const currentValue = parseInt(input.value) || 0;
        
        if (originalValue !== currentValue) {
            hasChanges = true;
        }
    });
    
    const guardarBtn = document.getElementById('guardar-btn');
    guardarBtn.disabled = !hasChanges;
}

// Función para actualizar totales
function updateTotales() {
    const inputs = document.querySelectorAll('input[name^="ejec_actual_"]');
    let totalEjecucionTotal = 0;
    
    inputs.forEach(input => {
        const ejecActual = parseInt(input.value) || 0;
        const ejecAnterior = parseInt(input.getAttribute('data-ejec-anterior')) || 0;
        const incidencia = parseFloat(input.getAttribute('data-incidencia')) || 0;
        
        // Solo calcular el total de ejecución total
        totalEjecucionTotal += ((incidencia / 100) * (ejecAnterior + ejecActual));
    });
    
    // Solo actualizar la columna de ejecución total
    document.getElementById('total_ejecucion_total').textContent = `${totalEjecucionTotal.toFixed(1)}%`;
    document.getElementById('info_ejecucion_total').textContent = `${totalEjecucionTotal.toFixed(1)}%`;
}

// Función para calcular totales iniciales
function calcularTotalesIniciales() {
    const inputs = document.querySelectorAll('input[name^="ejec_actual_"]');
    let totalEjecucionTotal = 0;
    
    inputs.forEach(input => {
        const ejecActual = parseInt(input.value) || 0;
        const ejecAnterior = parseInt(input.getAttribute('data-ejec-anterior')) || 0;
        const incidencia = parseFloat(input.getAttribute('data-incidencia')) || 0;
        
        // Calcular el total de ejecución total
        totalEjecucionTotal += ((incidencia / 100) * (ejecAnterior + ejecActual));
    });
    
    // Actualizar el total inicial
    document.getElementById('total_ejecucion_total').textContent = `${totalEjecucionTotal.toFixed(1)}%`;
    document.getElementById('info_ejecucion_total').textContent = `${totalEjecucionTotal.toFixed(1)}%`;
}

// Inicializar al cargar la página
document.addEventListener('DOMContentLoaded', function() {
    checkForChanges();
    calcularTotalesIniciales();
});
</script>
</file>

<file path="registros/templates/pages/generic_registro.html">
{% extends 'base.html' %}
{% load static crispy_forms_tags %}

{% block title %}{{ etapa|title }} - {{ registro_txtss.sitio.name|default:"Registro" }}{% endblock %}


{% block pre_content %}
    <div class="flex justify-between items-baseline">
        <div class="flex items-center gap-2">
            {% if is_editing %}
            <div class="badge badge-dash badge-warning">Editando</div>
            {% else %}
            <div class="badge badge-dash badge-success">Nuevo</div>
            {% endif %}
        </div>
    </div>
{% endblock pre_content %}

{% block content %}
<div class="container mx-auto">
    <div class="max-w-4xl mx-auto">
        <!-- Error Message -->
        {% if error %}
        <div class="alert alert-error mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{{ error }}</span>
        </div>
        {% endif %}

        <!-- Form Card -->
        <div class="card card-xs bg-base-200 shadow-xl">
            <div class="card-body">
                <h2 class="card-title">{{ sitio.name }}</h2>
                <!-- Form -->
                {% crispy form %}
            </div>
        </div>
    </div>
</div>
{% endblock content %} 

{% block post_content %}
<!-- Modal del mapa optimizado para móviles -->

<dialog id="mapa" class="modal modal-middle">
  <div
    class="w-full max-w-full sm:max-w-5xl h-screen sm:h-4/5 bg-white text-black rounded-lg"
  >
    <div class="rounded-lg shadow-xl flex flex-col h-full">
      <!-- Header -->
      <div
        class="flex justify-between items-center px-4 py-1 border-b border-base-300 shrink-0"
      >
        <h3 class="font-bold text-lg">Ubicación</h3>
        <button class="btn btn-sm btn-circle btn-ghost" onclick="mapa.close()">
          <i class="fa-solid fa-xmark text-xl"></i>
        </button>
      </div>

