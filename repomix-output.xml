                                        <div class="flex items-start space-x-3">
                                            <div class="flex-shrink-0">
                                                <i class="fas fa-info-circle text-info text-lg"></i>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <p class="text-sm text-base-content">{{ notification.message }}</p>
