                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="px-4 py-8 text-center">
                                <i class="fas fa-bell-slash text-base-content/40 text-2xl mb-2"></i>
                                <p class="text-sm text-base-content/60">No hay notificaciones</p>
