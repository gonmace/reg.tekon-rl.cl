from django import forms
from crispy_forms.helper import FormHelper
from crispy_forms.layout import Layout, Row, Column, Submit, Button, Div, Field
from .models.sites import Site


TIPO_COORDENADA_CHOICES = [
    ('MAN', 'Mandato'),
