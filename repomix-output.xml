<file path="widgets/templates/widgets/mapa_1p.html">
{% comment %}
widgets/mapa_1p.html
Widget de mapa Leaflet inline para un único punto de coordenadas.
Muestra el mapa directamente en la página, sin botón ni modal.

Nombre:
  Mapa 1 Punto

Tipo:
  ajax

Uso:
  include 'widgets/mapa_1p.html'

Parámetros:
  lat      — latitud decimal del punto (ej. -33.4569400), viene del contexto del sitio
  lon      — longitud decimal del punto (ej. -70.6482700), viene del contexto del sitio
  save_url — URL donde hacer POST para guardar imagen estática del mapa, viene del contexto

Config:
  height — obsoleto; el contenedor usa aspect-ratio:1/1 (cuadrado)
  color  — color hex del marcador, default #3b82f6 (azul)
  label  — letra del marcador, default M

Estados:
  0 — Sin coordenadas lat/lon disponibles
  1 — Coordenadas disponibles pero imagen estática sin generar
  3 — Imagen estática guardada correctamente
{% endcomment %}
{% load static %}

{% if lat and lon %}
<link rel="stylesheet" href="{% static 'css/leaflet.css' %}">
<div class="mapa-1-punto-widget rounded-lg overflow-hidden border border-base-300 sombra"
     data-lat="{{ lat }}"
     data-lon="{{ lon }}"
     data-color="{{ color|default:'#3b82f6' }}"
     data-label="{{ label|default:'M' }}"
     {% if save_url %}data-save-url="{{ save_url }}"{% endif %}>
  <div class="mapa-1-punto-container w-full" style="aspect-ratio:1/1;"></div>
  {% if save_url %}
  <div class="p-2 bg-base-100 border-t border-base-300 flex justify-end">
    <button type="button"
            class="btn btn-sm {% if imagen_guardada %}btn-success{% else %}btn-primary{% endif %} mapa-save-btn gap-2"
            {% if imagen_guardada %}data-saved="true"{% endif %}>
      {% if imagen_guardada %}
        <i class="fas fa-check"></i> Imagen guardada
      {% else %}
        <i class="fas fa-image"></i> Guardar imagen
      {% endif %}
    </button>
  </div>
  {% endif %}
</div>

<script src="{% static 'js/leaflet.js' %}"></script>
<script>
(function () {
  'use strict';
  function initMapas() {
    document.querySelectorAll('.mapa-1-punto-widget:not([data-initialized])').forEach(function (w) {
      w.dataset.initialized = 'true';
      var lat = parseFloat(w.dataset.lat);
      var lon = parseFloat(w.dataset.lon);
      if (isNaN(lat) || isNaN(lon)) return;

      var container = w.querySelector('.mapa-1-punto-container');
      var map = L.map(container, { zoomControl: false }).setView([lat, lon], 17);

      L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
        attribution: '© Esri'
      }).addTo(map);

      var color = w.dataset.color || '#3b82f6';
      var label = w.dataset.label || 'M';
      var icon = L.divIcon({
        className: '',
        html: '<div style="width:28px;height:28px;border-radius:50%;background:' + color + ';border:2px solid #fff;box-shadow:0 2px 4px rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:13px;">' + label + '</div>',
        iconSize: [28, 28],
        iconAnchor: [14, 14],
      });

      L.marker([lat, lon], { icon: icon })
        .addTo(map)
        .bindPopup('Lat: ' + lat.toFixed(6) + '<br>Lon: ' + lon.toFixed(6));

      L.control.zoom({ position: 'bottomright' }).addTo(map);

      w._leafletMap = map;
      var nivelInicial = w.dataset.saveUrl ? (w.querySelector('.mapa-save-btn[data-saved]') ? 3 : 1) : 0;
      window.parent.postMessage({ type: 'widget-state', level: nivelInicial }, '*');

      // Redibuja el mapa cuando el contenedor pasa de 0 a tener tamaño real (modal/iframe oculto al init)
      if (typeof ResizeObserver !== 'undefined') {
        var ro = new ResizeObserver(function (entries) {
          if (entries[0].contentRect.width > 0) {
            map.invalidateSize();
          }
        });
        ro.observe(container);
      }

      var saveBtn = w.querySelector('.mapa-save-btn');
      if (saveBtn) {
        saveBtn.addEventListener('click', function () {
          var saveUrl = w.dataset.saveUrl;
          if (!saveUrl) return;
          var zoom = w._leafletMap ? w._leafletMap.getZoom() : 20;
          var csrfEl = document.querySelector('[name=csrfmiddlewaretoken]');
          var csrf = csrfEl ? csrfEl.value : '';
          saveBtn.disabled = true;
          saveBtn.innerHTML = '<span class="loading loading-spinner loading-xs"></span> Guardando...';
          fetch(saveUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrf },
            body: JSON.stringify({ zoom: zoom, lat: lat, lon: lon, color: color, label: label }),
          })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data.success) {
              saveBtn.innerHTML = '<i class="fas fa-check"></i> Guardado';
              saveBtn.classList.replace('btn-primary', 'btn-success');
              window.parent.postMessage({ type: 'widget-state', level: 3 }, '*');
              window.Alert && window.Alert.success('Imagen guardada', { autoHide: 2000 });
            } else {
              saveBtn.disabled = false;
              saveBtn.innerHTML = '<i class="fas fa-image"></i> Guardar imagen';
              window.Alert && window.Alert.error(data.error || 'Error al guardar', { autoHide: 0, dismissible: true });
            }
          })
          .catch(function () {
            saveBtn.disabled = false;
            saveBtn.innerHTML = '<i class="fas fa-image"></i> Guardar imagen';
            window.Alert && window.Alert.error('Error de conexión', { autoHide: 0, dismissible: true });
          });
        });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMapas);
  } else {
    initMapas();
  }
})();
</script>
{% else %}
<div class="flex items-center justify-center h-24 rounded-lg border border-dashed border-base-300 text-base-content/30 text-sm gap-2">
  <i class="fa-solid fa-map-pin"></i> Sin coordenadas
</div>
<script>window.parent.postMessage({ type: 'widget-state', level: 0 }, '*');</script>
{% endif %}
</file>

