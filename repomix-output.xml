              <th>Widgets</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="pasos-tbody">
            {% for cp in config_pasos %}
            {% with widgets=cp.pasodef.paso_widgets.all %}
            <tr class="pt-2">
              <td class="text-center py-1 md:px-4">
                <span class="badge badge-sm badge-ghost font-mono">{{ cp.orden }}</span>
              </td>
