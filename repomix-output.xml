{% load static %}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>TX/TSS — {{ registro.sitio.pti_cell_id }}</title>
  <link rel="stylesheet" href="{% static 'css/weasyprint.css' %}">
</head>
<body>

<!-- ENCABEZADO -->
<div id="page-header">
  <table class="header-table">
    <tr>
      <td class="header-logo left">
        {% include "svgs/phoenix_tower_logo_horizontal.svg" %}
      </td>
      <td class="header-title">
        <h1>TX / Technical Site Survey<br>
        {{ registro.sitio.pti_cell_id }}</h1>
      </td>
      <td class="header-logo right">
        <img src="{{ tekon_logo_src }}" alt="Tekon">
      </td>
    </tr>
  </table>
</div>

<!-- PIE DE PÁGINA -->
<div id="page-footer">
  <span class="page-number"></span>
</div>

<!-- ============================================================
     1. DATOS GENERALES + INSPECCIÓN (lado a lado)
     ============================================================ -->
<div class="seccion-2col">
  <article class="seccion-2col-izq">
    <h2>Datos Generales del Sitio</h2>
    <table class="datos-2col">
      {% for key, value in datos_generales.items %}
      <tr>
        <th>{{ key }}</th>
        <td>{{ value }}</td>
      </tr>
      {% endfor %}
    </table>
  </article>

  <article class="seccion-2col-der">
    <h2>Datos de Inspección</h2>
    <table class="datos-2col">
      {% for key, value in inspeccion_sitio.items %}
      <tr>
        <th>{{ key }}</th>
        <td>{{ value }}</td>
      </tr>
      {% endfor %}
    </table>
  </article>
</div>

<!-- ============================================================
     2. MAPA DEL PUNTO DE MANDATO  (antes de Datos Geográficos)
     ============================================================ -->
{% if mapa_mandato_src %}
<article id="mapa-mandato">
