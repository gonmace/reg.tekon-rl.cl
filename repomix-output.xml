                        {% comment %} <a href="{% url 'users:profile' %}" {% endcomment %}
                        <a href="#"
                           class="block px-4 py-2 text-sm text-base-content hover:bg-base-200">
                            <i class="fas fa-user-circle mr-2"></i> Mi Perfil
                        </a>
