                descripcion_distancia=kwargs.get('descripcion_distancia', 'Distancia entre puntos'),
                zoom=zoom
            )
            sub_elementos.append(mapa_component)
        elif incluir_mapa:
            mapa_component = create_single_point_map_config(
                lat_field=lat_field,
