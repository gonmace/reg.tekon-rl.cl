                                                        <i class="fas fa-eye mr-2"></i>
                                                        Ver detalles
                                                    </a>
                                                </li>
                                                <li>
                                                    <a href="#" class="text-sm">
                                                        <i class="fas fa-download mr-2"></i>
                                                        Descargar
                                                    </a>
                                                </li>
                                                <li>
                                                    <a href="#" class="text-sm">
                                                        <i class="fas fa-edit mr-2"></i>
