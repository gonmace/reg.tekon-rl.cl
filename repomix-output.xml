                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <!-- Paginación -->
                    {% if page_obj.has_other_pages %}
                    <div class="flex justify-center mt-6">
                        <div class="join">
                            {% if page_obj.has_previous %}
                                <a href="?page={{ page_obj.previous_page_number }}{% if search_query %}&search={{ search_query }}{% endif %}{% if tipo_documento %}&tipo_documento={{ tipo_documento }}{% endif %}{% if fecha_desde %}&fecha_desde={{ fecha_desde }}{% endif %}" 
                                   class="join-item btn btn-outline btn-sm">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            {% endif %}
                            
                            {% for num in page_obj.paginator.page_range %}
                                {% if page_obj.number == num %}
                                    <span class="join-item btn btn-sm btn-active">{{ num }}</span>
                                {% elif num > page_obj.number|add:'-3' and num < page_obj.number|add:'3' %}
                                    <a href="?page={{ num }}{% if search_query %}&search={{ search_query }}{% endif %}{% if tipo_documento %}&tipo_documento={{ tipo_documento }}{% endif %}{% if fecha_desde %}&fecha_desde={{ fecha_desde }}{% endif %}" 
                                       class="join-item btn btn-outline btn-sm">{{ num }}</a>
                                {% endif %}
                            {% endfor %}
                            
                            {% if page_obj.has_next %}
                                <a href="?page={{ page_obj.next_page_number }}{% if search_query %}&search={{ search_query }}{% endif %}{% if tipo_documento %}&tipo_documento={{ tipo_documento }}{% endif %}{% if fecha_desde %}&fecha_desde={{ fecha_desde }}{% endif %}" 
                                   class="join-item btn btn-outline btn-sm">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                    {% endif %}
                {% else %}
                    <div class="text-center py-8">
                        <i class="fas fa-file-alt text-4xl text-base-content/30 mb-4"></i>
                        <p class="text-base-content/60">No se encontraron registros Technical Site Survey con los filtros aplicados</p>
                        <a href="{% url 'executive_dashboard:txtss' %}" class="btn btn-outline btn-sm mt-4">
                            Limpiar filtros
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock content %}
