<file path="photos/templates/photos/partials/gallery_grid.html">
{% load static %}
{% regroup photos by created_at.date as photos_by_date %}

<div class="p-2">

  {% if photos %}
  {# ── Select-all header ──────────────────────────────────────────────────── #}
  <div class="flex items-center gap-2 mb-3 px-1">
    <label class="flex items-center gap-2 cursor-pointer select-none text-sm text-base-content/60">
      <input type="checkbox" id="select-all-photos" class="checkbox checkbox-sm checkbox-primary" />
      Seleccionar todas ({{ page_obj.paginator.count }} total, {{ page_obj|length }} en esta página)
    </label>
  </div>

  {# ── Grouped by date ─────────────────────────────────────────────────────── #}
  {% for group in photos_by_date %}
  <div class="mb-5">

    {# Date header #}
    <div class="flex items-center gap-2 mb-2">
      <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">
        {{ group.grouper|date:"l d \d\e F \d\e Y" }}
      </span>
      <span class="badge badge-ghost badge-xs">{{ group.list|length }}</span>
      <div class="flex-1 border-t border-base-300"></div>
    </div>

    {# Grid for this date #}
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-2">
      {% for photo in group.list %}
      <div class="photo-card relative group rounded-lg overflow-hidden bg-base-200 border border-base-300 select-none transition-all duration-150"
           data-photo-id="{{ photo.pk }}">

        {# Select button — top right, circular #}
        <button type="button"
                class="photo-select-btn absolute top-1.5 right-1.5 z-20 w-6 h-6 rounded-full border-2 border-white/70 bg-black/30 flex items-center justify-center transition-all duration-150 hover:border-primary hover:bg-primary/20"
                title="Seleccionar">
          <input type="checkbox"
                 class="photo-checkbox sr-only"
                 value="{{ photo.pk }}" />
          <i class="fa-solid fa-check text-[0.55rem] text-white opacity-0 photo-check-icon transition-opacity duration-150"></i>
        </button>

        {# Selected highlight ring #}
        <div class="photo-selected-ring absolute inset-0 ring-2 ring-primary ring-inset rounded-lg opacity-0 pointer-events-none z-10 transition-opacity duration-150"></div>

        {# Thumbnail — click opens lightbox #}
        <img src="{{ photo.imagen.url }}"
             alt="{{ photo.descripcion|default:'' }}"
             loading="lazy"
             class="photo-thumb w-full h-32 object-cover cursor-pointer hover:brightness-90 transition-brightness duration-150"
             data-full-url="{{ photo.imagen.url }}"
             data-descripcion="{{ photo.descripcion|default:'' }}"
             data-etapa="{{ photo.etapa }}"
             data-created="{{ photo.created_at|date:'d/m/Y H:i' }}"
             data-exif-datetime="{{ photo.exif_datetime|date:'d/m/Y H:i'|default:'' }}" />

        {# Info strip #}
        <div class="px-1.5 py-1 bg-base-200 border-t border-base-300 pointer-events-none space-y-0.5">
          <div class="flex items-center justify-between">
            <span class="text-[0.65rem] text-base-content/50 truncate max-w-[60%]">{{ photo.etapa }}</span>
            <span class="text-[0.65rem] font-medium text-base-content/70 whitespace-nowrap">
              {% if photo.file_size %}{{ photo.file_size|filesizeformat }}{% else %}—{% endif %}
            </span>
          </div>
          <div class="text-[0.6rem] text-base-content/40 leading-tight space-y-0.5">
            {% if photo.exif_datetime %}
            <div class="flex items-center gap-1">
              <i class="fa-regular fa-clock w-2.5 shrink-0"></i>
              <span>{{ photo.exif_datetime|date:"d/m/Y H:i" }}</span>
            </div>
            {% elif photo.created_at %}
            <div class="flex items-center gap-1">
              <i class="fa-regular fa-clock w-2.5 shrink-0"></i>
              <span>{{ photo.created_at|date:"d/m/Y H:i" }}</span>
            </div>
            {% endif %}
            {% if photo.exif_lat and photo.exif_lon %}
            <div class="flex items-center gap-1">
              <i class="fa-solid fa-location-dot w-2.5 shrink-0"></i>
              <span>{{ photo.exif_lat|floatformat:4 }}, {{ photo.exif_lon|floatformat:4 }}</span>
            </div>
            {% endif %}
          </div>
        </div>

      </div>
      {% endfor %}
    </div>

  </div>
  {% endfor %}

  {# ── Pagination ─────────────────────────────────────────────────────────── #}
  {% if page_obj.has_other_pages %}
  <div class="flex justify-center items-center gap-1 mt-4 flex-wrap">
    {% if page_obj.has_previous %}
      <a href="?{% for k, v in request.GET.items %}{% if k != 'page' %}{{ k }}={{ v }}&{% endif %}{% endfor %}page={{ page_obj.previous_page_number }}"
         class="btn btn-sm btn-ghost"
         hx-get="?{% for k, v in request.GET.items %}{% if k != 'page' %}{{ k }}={{ v }}&{% endif %}{% endfor %}page={{ page_obj.previous_page_number }}"
         hx-target="#gallery-grid-wrapper"
         hx-push-url="true"
         hx-swap="innerHTML">
        <i class="fa-solid fa-chevron-left text-xs"></i>
      </a>
    {% endif %}
    <span class="text-sm text-base-content/60 px-2">
      Página {{ page_obj.number }} de {{ page_obj.paginator.num_pages }}
    </span>
    {% if page_obj.has_next %}
      <a href="?{% for k, v in request.GET.items %}{% if k != 'page' %}{{ k }}={{ v }}&{% endif %}{% endfor %}page={{ page_obj.next_page_number }}"
         class="btn btn-sm btn-ghost"
         hx-get="?{% for k, v in request.GET.items %}{% if k != 'page' %}{{ k }}={{ v }}&{% endif %}{% endfor %}page={{ page_obj.next_page_number }}"
         hx-target="#gallery-grid-wrapper"
         hx-push-url="true"
         hx-swap="innerHTML">
        <i class="fa-solid fa-chevron-right text-xs"></i>
      </a>
    {% endif %}
  </div>
  {% endif %}

  {% else %}
  <div class="flex flex-col items-center justify-center py-16 text-base-content/40 gap-2">
    <i class="fa-solid fa-images text-5xl"></i>
    <p class="text-sm">No se encontraron imágenes con los filtros seleccionados.</p>
  </div>
  {% endif %}

</div>
</file>

